#!/usr/bin/env bash
# pre-commit — Quality-Gate Layer 2: ESLint + Typecheck + Semgrep
# Installiert via: bash scripts/install-hooks.sh (setzt core.hooksPath=.githooks)
#
# Die Semgrep-Packs kommen aus .semgrep.yml — nicht mehr hartkodiert.
# Frueher stand die Liste hier UND im CI-Workflow UND (auskommentiert) im
# Manifest; das Manifest las niemand. Befund vom 08.08.2026, siehe
# docs/audits/2026-08-08-gate-verdrahtung.md.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
MANIFEST="${REPO_ROOT}/.semgrep.yml"

echo "=== Pre-Commit Gate (Layer 2) ==="

# 1. ESLint
echo "[1/3] ESLint..."
if command -v npx &>/dev/null; then
  npx eslint . 2>/dev/null || {
    echo "BLOCKED: ESLint-Fehler gefunden. Bitte beheben."
    exit 1
  }
else
  echo "WARN: npx nicht verfuegbar, ESLint uebersprungen."
fi

# 2. TypeScript Typecheck
echo "[2/3] TypeScript Typecheck..."
if command -v npx &>/dev/null; then
  npx tsc --noEmit 2>/dev/null || {
    echo "BLOCKED: TypeScript-Fehler gefunden. Bitte beheben."
    exit 1
  }
else
  echo "WARN: npx nicht verfuegbar, Typecheck uebersprungen."
fi

# 3. Semgrep — Packs aus dem Manifest
echo "[3/3] Semgrep..."
if ! command -v semgrep &>/dev/null; then
  echo "WARN: Semgrep nicht installiert, SAST uebersprungen."
  echo "      Installation: brew install semgrep"
elif [ ! -f "$MANIFEST" ]; then
  echo "WARN: .semgrep.yml fehlt, SAST uebersprungen."
else
  PACKS="$(grep -E '^[[:space:]]*-[[:space:]]+p/' "$MANIFEST" | sed -E 's/^[[:space:]]*-[[:space:]]+//')"
  if [ -z "$PACKS" ]; then
    # Kein stilles Durchwinken: ein leeres Manifest ist ein Befund, kein Gruen.
    echo "BLOCKED: .semgrep.yml enthaelt keine aktiven Packs (Zeilen '  - p/...')."
    echo "         Entweder Packs eintragen oder das Gate bewusst in CONVENTIONS.md abschalten."
    exit 1
  fi
  CONFIG_FLAGS=""
  for pack in $PACKS; do
    CONFIG_FLAGS="$CONFIG_FLAGS --config $pack"
  done
  echo "      Packs: $(echo "$PACKS" | tr '\n' ' ')"
  # shellcheck disable=SC2086
  semgrep $CONFIG_FLAGS --error --quiet --metrics=off 2>/dev/null || {
    echo "BLOCKED: Semgrep-Findings. Bitte beheben."
    exit 1
  }
fi

echo "=== Pre-Commit Gate: PASS ==="
exit 0
